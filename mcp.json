{
  "instructions": "job-service runs jobs: a job is a named script in a repo's jobs.toml, a run one execution of it at one commit, claimed by a runner whose labels and free memory fit.\n\n- A run is submitted pending, claimed and running, and ends succeeded, failed or canceled with its exit code.\n- A run's log is read from a byte offset: get_run_log answers the bytes from offset, the log's size, and the run's state, so call it again from offset + the bytes read until the state has ended.\n- cancel_run ends a pending run at once; a running one is canceled by its runner shortly after.\n- Every tool takes the submitters' token this server was connected with. Registering runners and their claims and reports are the runner protocol, not tools.",
  "tools": [
    {
      "name": "submit_run",
      "title": "Submit a run",
      "description": "Queues a run as `pending` until a runner claims it. The repo isn't checked here: a missing job fails on its runner.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "repo": {
            "type": "string",
            "maxLength": 200,
            "pattern": "^[A-Za-z0-9_.-]+\\/[A-Za-z0-9_.-]+$",
            "description": "GitHub repo, `owner/name`."
          },
          "commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$",
            "description": "Full commit sha to check out."
          },
          "job": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$",
            "description": "A `[jobs.<name>]` in the repo's `jobs.toml`."
          },
          "args": {
            "default": [],
            "description": "Arguments appended to the job's command.",
            "maxItems": 50,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 4000
            }
          },
          "limits": {
            "default": {
              "memory": null,
              "timeout": null
            },
            "type": "object",
            "properties": {
              "memory": {
                "default": null,
                "description": "Memory in MiB. Default: `jobs.toml`'s, else 1024.",
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 16,
                    "maximum": 1048576
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "timeout": {
                "default": null,
                "description": "Timeout in seconds. Default: `jobs.toml`'s.",
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 86400
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "labels": {
            "default": {},
            "description": "Key-value labels. On a run, what its runner must have.",
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[A-Za-z0-9]([A-Za-z0-9_.-]{0,61}[A-Za-z0-9])?$"
            },
            "additionalProperties": {
              "type": "string",
              "pattern": "^[A-Za-z0-9]([A-Za-z0-9_.-]{0,61}[A-Za-z0-9])?$"
            }
          },
          "for": {
            "default": null,
            "description": "What the run is for: filter with `ListRuns?for=<kind>:<id>`.",
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "batch",
                      "change",
                      "item",
                      "worker"
                    ],
                    "description": "What kind of thing asked for it."
                  },
                  "id": {
                    "type": "string",
                    "pattern": "^\\S{1,200}$",
                    "description": "Its id."
                  }
                },
                "required": [
                  "kind",
                  "id"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "routine": {
            "default": null,
            "description": "Run a job from another repo's `jobs.toml` against this repo (used by release routines).",
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "repo": {
                    "type": "string",
                    "maxLength": 200,
                    "pattern": "^[A-Za-z0-9_.-]+\\/[A-Za-z0-9_.-]+$"
                  },
                  "commit": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{40}$",
                    "description": "Full commit sha of that repo."
                  },
                  "dir": {
                    "type": "string",
                    "maxLength": 200,
                    "pattern": "^(?!\\.{1,2}(\\/|$))[A-Za-z0-9_.-]+(\\/(?!\\.{1,2}(\\/|$))[A-Za-z0-9_.-]+)*$"
                  }
                },
                "required": [
                  "repo",
                  "commit",
                  "dir"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "host": {
            "default": null,
            "description": "Run on this host itself, outside a container. Default: any runner, in a container.",
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "description": "Host name, as worker-host knows it."
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "repo",
          "commit",
          "job"
        ]
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "list_runs",
      "title": "List runs",
      "description": "Returns runs matching every filter given, newest first.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "state": {
            "description": "`pending` → `running` → `succeeded`, `failed` or `canceled`.",
            "type": "string",
            "enum": [
              "pending",
              "running",
              "succeeded",
              "failed",
              "canceled"
            ]
          },
          "repo": {
            "description": "GitHub repo, `owner/name`.",
            "type": "string",
            "maxLength": 200,
            "pattern": "^[A-Za-z0-9_.-]+\\/[A-Za-z0-9_.-]+$"
          },
          "submittedBy": {
            "description": "Only runs with this `submittedBy`.",
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "for": {
            "description": "Only runs for this `<kind>:<id>`.",
            "type": "string"
          },
          "limit": {
            "default": 100,
            "description": "Max results. Default: 100.",
            "type": "integer",
            "minimum": 1,
            "maximum": 500
          }
        }
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "get_run",
      "title": "Get a run",
      "description": "Returns one run.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "description": "The run's id."
          }
        },
        "required": [
          "id"
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "get_run_log",
      "title": "Read a run's log",
      "description": "Returns the log from byte `offset`, at most 1 MiB, with the log's size so far and the run's state. Empty when `offset` is the log's size: call again later from there while the run is `pending` or `running`.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "description": "The run's id."
          },
          "offset": {
            "description": "The byte to read from; default 0.",
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "id"
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "cancel_run",
      "title": "Cancel a run",
      "description": "Ends a pending run now. A running one is stopped by its runner within seconds.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "description": "The run's id."
          }
        },
        "required": [
          "id"
        ]
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "list_runners",
      "title": "List runners",
      "description": "Returns every registered runner, most recently seen first, with its labels and host.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {}
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    }
  ]
}
