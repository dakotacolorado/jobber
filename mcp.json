{
  "instructions": "jobber runs code on whatever computers you have, its hosts: a job is a named script in a repo's jobs.toml, a run one execution of it at one commit, placed by its scheduler on a host that meets its requirements (os, arch) and has its cpu and memory free.\n\n- A run is submitted pending, assigned to a host by the scheduler, running there, and ends succeeded, failed or canceled with its exit code.\n- A run's log is read from a byte offset: get_run_log answers the bytes from offset, the log's size, and the run's state, so call it again from offset + the bytes read until the state has ended.\n- Label runs to find them again (e.g. {\"item\": \"28af81bc\", \"by\": \"agent-7\"}); list_runs filters by label as key=value.\n- Pending runs are taken highest priority first, then oldest: list_queue lists them in that order, next first. Give priority when submitting, or move a run with update_run_priority.\n- Give retry {limit, backoff} to try a failed run again: each attempt keeps its own log and exit, the run's attempts lists the earlier ones, and get_run_log reads any by attempt.\n- cancel_run ends a pending or assigned run at once; a running one is stopped by its host shortly after.\n- Every tool takes the submitters' token this server was connected with. The host protocol (register, connect, heartbeat, append, complete) is jobber-host's, not tools.",
  "tools": [
    {
      "name": "submit_run",
      "title": "Submit a run",
      "description": "Queues a run as `pending`, by `priority` then age, until a host that meets its requirements takes it. The repo isn't checked here: a missing job fails on its host. Refused if a secret it names is not set, if `requirements.host` names no registered host, or if it is `onHost` without one.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "repo": {
            "type": "string",
            "maxLength": 200,
            "pattern": "^[A-Za-z0-9_.-]+\\/[A-Za-z0-9_.-]+$",
            "description": "GitHub repo, `owner/name`."
          },
          "commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$",
            "description": "Full commit sha to check out."
          },
          "job": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$",
            "description": "A `[jobs.<name>]` in the repo's `jobs.toml`."
          },
          "args": {
            "default": [],
            "description": "Arguments appended to the job's command.",
            "maxItems": 50,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 4000
            }
          },
          "requirements": {
            "default": {
              "os": null,
              "arch": null,
              "cpu": null,
              "memory": null,
              "timeout": null,
              "host": null
            },
            "description": "What the run needs from its host.",
            "type": "object",
            "properties": {
              "os": {
                "default": null,
                "description": "Operating system it needs. Default: any.",
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "linux",
                      "macos",
                      "windows"
                    ],
                    "description": "Operating system."
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "arch": {
                "default": null,
                "description": "CPU architecture it needs. Default: any.",
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "x86_64",
                      "aarch64"
                    ],
                    "description": "CPU architecture."
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "cpu": {
                "default": null,
                "description": "CPUs, a decimal number (e.g. 0.5). Default: 0.5.",
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0.001,
                    "maximum": 65536
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "memory": {
                "default": null,
                "description": "Memory in MiB. Default: `jobs.toml`'s, else 1024.",
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 16,
                    "maximum": 1048576
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "timeout": {
                "default": null,
                "description": "Timeout in seconds. Default: `jobs.toml`'s.",
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 86400
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "host": {
                "default": null,
                "description": "Name of the host it must run on, which must be registered. Default: any. A run `onHost` names one.",
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "labels": {
            "default": {},
            "description": "Labels to find it by, e.g. what it is for and who asked.",
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[A-Za-z0-9]([A-Za-z0-9_.-]{0,61}[A-Za-z0-9])?$"
            },
            "additionalProperties": {
              "type": "string",
              "pattern": "^[A-Za-z0-9]([A-Za-z0-9_.-]{0,61}[A-Za-z0-9])?$"
            }
          },
          "priority": {
            "default": 0,
            "description": "Higher is placed first; equal ones oldest first. -1000 to 1000. Default: 0.",
            "type": "integer",
            "minimum": -1000,
            "maximum": 1000
          },
          "retry": {
            "default": {
              "limit": 0,
              "backoff": 10
            },
            "description": "Retries a failed attempt (not a canceled one).",
            "type": "object",
            "properties": {
              "limit": {
                "default": 0,
                "description": "Retries after a failed attempt, 0 to 10. Default: 0.",
                "type": "integer",
                "minimum": 0,
                "maximum": 10
              },
              "backoff": {
                "default": 10,
                "description": "Seconds before the first retry, doubling for each after, at most 3600. Default: 10.",
                "type": "integer",
                "minimum": 1,
                "maximum": 3600
              }
            }
          },
          "secrets": {
            "default": [],
            "description": "Secrets its host gives it, each as an environment variable of its name, masked in its log. Each must be set (`PutSecret`). Default: none.",
            "maxItems": 50,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z_][A-Z0-9_]{0,127}$"
            }
          },
          "onHost": {
            "default": false,
            "description": "Run on the host `requirements.host` names itself, as its user, in the checkout, outside a container. That host's jobber-host runs it only for a repo on its `host_runs` allowlist, and fails it otherwise. Default: false.",
            "type": "boolean"
          }
        },
        "required": [
          "repo",
          "commit",
          "job"
        ]
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "list_runs",
      "title": "List runs",
      "description": "Returns runs matching every filter given, newest first.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "state": {
            "description": "`pending` → `assigned` → `running` → `succeeded`, `failed` or `canceled`. An assignment not taken goes back to `pending`.",
            "type": "string",
            "enum": [
              "pending",
              "assigned",
              "running",
              "succeeded",
              "failed",
              "canceled"
            ]
          },
          "repo": {
            "description": "GitHub repo, `owner/name`.",
            "type": "string",
            "maxLength": 200,
            "pattern": "^[A-Za-z0-9_.-]+\\/[A-Za-z0-9_.-]+$"
          },
          "label": {
            "description": "Only runs with this label, as `key=value`. Repeat to require several.",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "limit": {
            "default": 100,
            "description": "Max results. Default: 100.",
            "type": "integer",
            "minimum": 1,
            "maximum": 500
          }
        }
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "list_queue",
      "title": "List the queue",
      "description": "The `pending` runs in the order the scheduler places them: highest `priority` first, then oldest. The first is next to go to a host that fits it; one no host fits is passed over, not waited for, and one waiting out a retry's backoff is listed with its `retryAt`. Move a run with `UpdateRunPriority`.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "limit": {
            "default": 100,
            "description": "Max results. Default: 100.",
            "type": "integer",
            "minimum": 1,
            "maximum": 500
          }
        }
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "get_run",
      "title": "Get a run",
      "description": "Returns one run.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "description": "The run's id."
          }
        },
        "required": [
          "id"
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "get_run_log",
      "title": "Read a run's log",
      "description": "Returns the latest attempt's log, or `attempt`'s, from byte `offset`, at most 1 MiB, with the log's size so far and the attempt's state. Empty when `offset` is the log's size: call again later from there while the run is `pending` or `running`.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "description": "The run's id."
          },
          "offset": {
            "description": "The byte to read from; default 0.",
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "attempt": {
            "description": "Which attempt's log; default the latest. A run's `attempts` lists its earlier ones.",
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "id"
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "cancel_run",
      "title": "Cancel a run",
      "description": "Ends a run not yet started (pending or assigned) now. A running one is stopped by its host within seconds.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "description": "The run's id."
          }
        },
        "required": [
          "id"
        ]
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "update_run_priority",
      "title": "Update run priority",
      "description": "Moves a run not yet ended up or down the queue. A running one keeps its host.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "description": "The run's id."
          },
          "priority": {
            "type": "integer",
            "minimum": -1000,
            "maximum": 1000,
            "description": "Higher is placed first; equal ones oldest first. -1000 to 1000."
          }
        },
        "required": [
          "id",
          "priority"
        ]
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "list_hosts",
      "title": "List hosts",
      "description": "Returns every host in the fleet, most recently seen first, with its capacity, free capacity and health.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {}
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    }
  ]
}
