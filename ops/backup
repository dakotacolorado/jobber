#!/bin/sh
# backup STAGE OTHER_HOST: copies a consistent backup of this host's
# jobber database to OTHER_HOST over the tailnet, as
# ~/backups/jobber/jobber-STAGE-<date>.db there, and keeps 14 days of them,
# counting those job-service made (~/backups/job-service/job-service-STAGE-*,
# moved over and renamed the first time). Run by jobber-backup.timer, which
# ops/deploy installs.
set -eu
umask 077
[ $# -eq 2 ] || { echo "usage: backup STAGE OTHER_HOST" >&2; exit 2; }
stage=$1 other=$2
. "$(dirname "$0")/common"
name=jobber-$stage-$(date -u +%F).db
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
"$node" "$routines/$app/current/dist/cli.js" backup --db "$data/jobber.db" "$tmp/$name"
ssh -o BatchMode=yes "$other" "mkdir -p ~/backups/jobber && for f in ~/backups/job-service/job-service-$stage-*.db; do [ ! -e \"\$f\" ] || mv -n \"\$f\" ~/backups/jobber/jobber-\${f##*/job-service-}; done"
scp -q -o BatchMode=yes "$tmp/$name" "$other:backups/jobber/$name.partial"
ssh -o BatchMode=yes "$other" "mv ~/backups/jobber/$name.partial ~/backups/jobber/$name && find ~/backups/jobber -name 'jobber-$stage-*.db' -mtime +13 -delete"
echo "backup: $name is on $other"
