#!/bin/sh
# check [REPO COMMIT JOB]: run on a host after ops/deploy and ops/runner.
# Submits a run (default: dakotacolorado/python-template's hello at its
# main) to this host's job-service at its public address, follows its log,
# and exits with the run's exit: 0 once it ends `succeeded`. Then lists the
# hosts, which name the one that ran it.
set -eu
here=$(cd "$(dirname "$0")" && pwd)
. "$here/common"
repo=${1:-dakotacolorado/python-template}
commit=${2:-$(git ls-remote "https://github.com/$repo.git" refs/heads/main | cut -f1)}
job=${3:-hello}
# The token goes to node by its environment, never on a command line.
JS_TOKEN=$(token AUTH_TOKEN) exec "$node" --input-type=module - "$url" "$repo" "$commit" "$job" <<'JS'
const [url, repo, commit, job] = process.argv.slice(2);
const headers = { authorization: `Bearer ${process.env.JS_TOKEN}` };
const call = async (method, path, body, extra = {}) => {
  const res = await fetch(url + path, { method, headers: { ...headers, ...extra, ...(body && { "content-type": "application/json" }) }, body: body && JSON.stringify(body) });
  if (!res.ok && res.status !== 206) throw new Error(`${method} ${path}: ${res.status} ${await res.text()}`);
  return res;
};
const run = await (await call("POST", "/runs", { repo, commit, job, labels: { by: "job-service-check" } })).json();
console.log(`check: run ${run.id} of ${repo} ${job} at ${commit}, on ${url}`);
const ended = ["succeeded", "failed", "canceled"];
let offset = 0;
for (;;) {
  const res = await call("GET", `/runs/${run.id}/log`, undefined, { range: `bytes=${offset}-` });
  const bytes = new Uint8Array(await res.arrayBuffer());
  process.stdout.write(bytes);
  offset += bytes.length;
  const size = Number(res.headers.get("content-range")?.split("/")[1] ?? offset);
  if (ended.includes(res.headers.get("run-state")) && offset >= size) break;
  if (!bytes.length) await new Promise((ok) => setTimeout(ok, 1000));
}
const end = await (await call("GET", `/runs/${run.id}`)).json();
console.log(`check: run ${end.id} ${end.state}, exit ${end.exit}, ${end.logSize} bytes of log, on host ${end.host}`);
for (const h of (await (await call("GET", "/hosts")).json()).hosts) console.log(`check: host ${h.id} ${h.name} (${h.os} ${h.arch}), version ${h.version}, load ${h.metrics?.cpuLoad ?? "?"}, last seen ${h.lastSeenAt}`);
process.exit(end.state === "succeeded" ? 0 : (end.exit || 1));
JS
