#!/bin/sh
# deploy STAGE OTHER_HOST: run on a host, from a checkout of jobber at the
# commit to release. Builds it, installs it as
# ~/.local/share/routines/jobber/versions/<version>+<commit> and points
# current at it (the one it replaces is previous), makes the host's tokens
# once (~/.config/jobber/env, mode 600), writes and restarts jobber.service,
# and checks /health answers this commit; if not, puts previous back and
# fails. Exposes it at https://<host>:8445 with tailscale serve, and installs
# the nightly backup to OTHER_HOST. Prints `deployed: <commit>`.
# Run at an earlier commit, it puts that release back.
#
# On a host still serving job-service, the first deploy stops and disables
# job-service.service and its backup timer, and copies its env (the same
# tokens, so its hosts stay registered) and its database to jobber's paths.
# The old ones are left where they were, as they were, and its units
# disabled, not removed: if this first jobber does not answer, job-service is
# started again on them.
set -eu
[ $# -eq 2 ] || { echo "usage: deploy STAGE OTHER_HOST" >&2; exit 2; }
stage=$1 other=$2
here=$(cd "$(dirname "$0")" && pwd)
. "$here/common"
src=$(cd "$here/.." && pwd)
commit=$(git -C "$src" rev-parse HEAD)
[ -z "$(git -C "$src" status --porcelain)" ] || { echo "deploy: $src has uncommitted changes" >&2; exit 1; }
version=$("$node" -p "require('$src/package.json').version")+$(printf %.7s "$commit")

(cd "$src" && npm ci --no-audit --no-fund && npm run build) >&2

dest=$routines/$app/versions/$version
if [ ! -d "$dest" ]; then
  rm -rf "$dest.partial"
  mkdir -p "$dest.partial"
  cp -R "$src/dist" "$src/docs" "$src/ui" "$src/mcp.json" "$src/package.json" "$src/package-lock.json" "$dest.partial/"
  # Built above: `prepare` would build again, without the dev dependencies that takes.
  (cd "$dest.partial" && npm ci --omit=dev --ignore-scripts --no-audit --no-fund) >&2
  mv "$dest.partial" "$dest"
fi
was=$(readlink "$routines/$app/current" 2>/dev/null || true)
if [ "$was" != "versions/$version" ]; then
  [ -n "$was" ] && echo "$was" >"$routines/$app/previous"
  ln -sfn "versions/$version" "$routines/$app/current.new"
  mv -T "$routines/$app/current.new" "$routines/$app/current"
fi
# Keep current, previous and three more.
keep=$(cat "$routines/$app/previous" 2>/dev/null || true)
ls -1t "$routines/$app/versions" | tail -n +6 | while read -r old; do
  [ "versions/$old" = "versions/$version" ] || [ "versions/$old" = "$keep" ] || rm -rf "$routines/$app/versions/$old"
done
echo "deploy: $routines/$app/current is $version (was ${was:-nothing})"

umask 077
mkdir -p "$conf" "$data"
moved=
if [ -e "$units/$old_app.service" ] && systemctl --user is-enabled -q "$old_app.service" 2>/dev/null; then
  systemctl --user disable --now "$old_app-backup.timer" >/dev/null 2>&1 || true
  systemctl --user disable --now "$old_app.service" >/dev/null 2>&1 || true
  echo "deploy: stopped and disabled $old_app.service and $old_app-backup.timer"
  moved=1
fi
if [ ! -s "$conf/env" ] && [ -s "$old_conf/env" ]; then
  cp -p "$old_conf/env" "$conf/env"
  echo "deploy: copied $old_conf/env to $conf/env, the same tokens"
fi
if [ ! -e "$data/jobber.db" ] && [ -e "$old_data/job-service.db" ]; then
  # Stopped above, so the database and its WAL are at rest.
  for suffix in "" -wal -shm; do
    [ ! -e "$old_data/job-service.db$suffix" ] || cp -p "$old_data/job-service.db$suffix" "$data/jobber.db$suffix"
  done
  echo "deploy: copied $old_data/job-service.db to $data/jobber.db"
fi
if [ ! -s "$conf/env" ]; then
  printf 'AUTH_TOKEN=%s\nRUNNER_TOKEN=%s\n' "$(openssl rand -hex 32)" "$(openssl rand -hex 32)" >"$conf/env"
  echo "deploy: made $conf/env (AUTH_TOKEN and RUNNER_TOKEN, mode 600)"
fi
umask 022

mkdir -p "$units"
cat >"$units/$app.service" <<UNIT
[Unit]
Description=jobber ($stage): runs of code, pushed to the computers of its fleet (dakotacolorado/jobber ops/)
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=%h/.config/jobber/env
Environment=JOBBER_DB=%h/.local/share/jobber/jobber.db
Environment=JOBBER_HOST=127.0.0.1
Environment=JOBBER_PORT=$port
Environment=JOBBER_PUBLIC_URL=$url
ExecStart=$node %h/.local/share/routines/$app/current/dist/cli.js serve
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
UNIT

check() {
  i=0
  while [ $i -lt 30 ]; do
    if curl -fsS "http://127.0.0.1:$port/health" 2>/dev/null | grep -q "\"commit\":\"$commit\""; then return 0; fi
    i=$((i + 1))
    sleep 1
  done
  return 1
}
systemctl --user daemon-reload
systemctl --user enable "$app.service" >/dev/null 2>&1
systemctl --user restart "$app.service"
if ! check; then
  echo "deploy: $version did not answer /health with $commit; putting back ${was:-nothing}" >&2
  journalctl --user -u "$app.service" -n 20 --no-pager >&2 || true
  if [ -n "$was" ]; then
    ln -sfn "$was" "$routines/$app/current.new" && mv -T "$routines/$app/current.new" "$routines/$app/current"
    systemctl --user restart "$app.service"
  elif [ -n "$moved" ]; then
    systemctl --user disable --now "$app.service" >/dev/null 2>&1 || true
    # Copied again at the next try, with what job-service writes meanwhile.
    rm -f "$conf/env" "$data/jobber.db" "$data/jobber.db-wal" "$data/jobber.db-shm"
    systemctl --user enable --now "$old_app.service" "$old_app-backup.timer" >/dev/null 2>&1
    echo "deploy: started $old_app.service again, on its own data" >&2
  fi
  exit 1
fi
echo "deploy: http://127.0.0.1:$port/health answers $commit"

# Changing the serve config needs root unless this user is tailscale's operator.
tailscale serve --bg --https="$https_port" "http://127.0.0.1:$port" >/dev/null 2>&1 ||
  sudo -n tailscale serve --bg --https="$https_port" "http://127.0.0.1:$port" >/dev/null
curl -fsS "$url/health" | grep -q "\"commit\":\"$commit\"" || { echo "deploy: $url/health does not answer $commit" >&2; exit 1; }
echo "deploy: $url/health answers $commit"

mkdir -p "$routines/$app-backup"
cp "$here/common" "$here/backup" "$routines/$app-backup/"
cat >"$units/$app-backup.service" <<UNIT
[Unit]
Description=jobber's nightly backup to $other

[Service]
Type=oneshot
ExecStart=/bin/sh %h/.local/share/routines/$app-backup/backup $stage $other
UNIT
cat >"$units/$app-backup.timer" <<UNIT
[Unit]
Description=jobber's nightly backup to $other

[Timer]
OnCalendar=*-*-* 03:45:00
RandomizedDelaySec=15min
Persistent=true

[Install]
WantedBy=timers.target
UNIT
systemctl --user daemon-reload
systemctl --user enable --now "$app-backup.timer" >/dev/null 2>&1
echo "deploy: $app-backup.timer backs up to $other nightly"
echo "deployed: $commit"
