#!/bin/sh
# runner STAGE BINARY RESERVE_CPU RESERVE_MIB: run on a host after ops/deploy. Installs a
# second job-runner, beside the host's own (which stays on the AWS
# job-service until cutover), registered with this host's jobber:
# BINARY (a job-runner with the `api = "hosts"` mode) as
# ~/.local/share/routines/job-runner-local/job-runner, its config in
# ~/.config/job-runner-local/, its identity in ~/.local/state/job-runner-local/,
# its checkouts in ~/.local/share/job-runner-local/, its jobs in its own
# jobslocal.slice, and job-runner-local.service. It measures the machine's
# CPUs and memory each time it starts and offers jobs that less RESERVE_CPU
# CPUs and RESERVE_MIB MiB, kept back for everything else on the host (the
# AWS job-runner's jobs.slice, the services, agents, a desktop); the slice is
# sized to what it offers. Rerun to upgrade or to change the reserve: it
# keeps its identity, and registers its capacity and version again.
set -eu
[ $# -eq 4 ] || { echo "usage: runner STAGE BINARY RESERVE_CPU RESERVE_MIB" >&2; exit 2; }
stage=$1 binary=$2 reserve_cpu=$3 reserve_memory=$4
here=$(cd "$(dirname "$0")" && pwd)
. "$here/common"
name=job-runner-local
rconf=$HOME/.config/$name
mkdir -p "$routines/$name" "$rconf" "$HOME/.local/state/$name" "$HOME/.local/share/$name" "$units"
cp "$binary" "$routines/$name/job-runner.new"
chmod 755 "$routines/$name/job-runner.new"
mv "$routines/$name/job-runner.new" "$routines/$name/job-runner"
bin=$routines/$name/job-runner
echo "runner: installed $bin ($("$bin" --version))"

(umask 077 && token RUNNER_TOKEN >"$rconf/registration-token")
host_id=$(sed -n 's/^host_id *= *"\(.*\)"/\1/p' "$HOME/.config/job-runner/config.toml")
[ -n "$host_id" ] || host_id=$(hostname)
cat >"$rconf/config.toml" <<CONF
# The second job-runner on this host, registered with its own jobber
# ($stage), written by dakotacolorado/jobber's ops/runner.
service = "http://127.0.0.1:$port"
api = "hosts"
registration_token_file = "$rconf/registration-token"
state_file = "$HOME/.local/state/$name/runner.json"
work_dir = "$HOME/.local/share/$name"
name = "$host_id"
host_id = "$host_id"
# Kept back from jobs: the rest of what job-runner measures, it offers them.
reserve = { cpu = $reserve_cpu, memory = $reserve_memory }
git_credential_helper = "!gh auth git-credential"
cgroup_parent = "jobslocal.slice"

[slice]
cpu_weight = 20
CONF
"$bin" --config "$rconf/config.toml" --slice-unit >"$units/jobslocal.slice.new"
mv "$units/jobslocal.slice.new" "$units/jobslocal.slice"
echo "runner: jobslocal.slice: $(grep -E '^(MemoryMax|CPUQuota)=' "$units/jobslocal.slice" | tr '\n' ' ')"
cat >"$units/$name.service" <<UNIT
[Unit]
Description=job-runner for this host's own jobber ($stage), in jobslocal.slice
After=network-online.target $app.service

[Service]
ExecStart=$bin --config $rconf/config.toml
# SIGTERM to job-runner alone: it stops and reports its jobs itself.
KillMode=mixed
TimeoutStopSec=90
Restart=always
RestartSec=10
Environment=PATH=$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=default.target
UNIT
systemctl --user daemon-reload
systemctl --user enable "$name.service" >/dev/null 2>&1
systemctl --user restart "$name.service"
echo "runner: (re)started $name.service; its log: journalctl --user -u $name -f"
