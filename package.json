{
  "name": "@dakotajp/jobber",
  "version": "0.2.0",
  "description": "Submit code to run on whatever computers you have.",
  "keywords": [
    "jobs",
    "scheduler",
    "runner",
    "mcp",
    "sqlite",
    "api"
  ],
  "homepage": "https://github.com/dakotacolorado/jobber",
  "bugs": {
    "url": "https://github.com/dakotacolorado/jobber/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dakotacolorado/jobber.git"
  },
  "license": "MIT",
  "author": "Dakota Parker",
  "type": "module",
  "bin": {
    "jobber": "dist/cli.js"
  },
  "files": [
    "dist",
    "ui",
    "docs",
    "openapi.json",
    "mcp.json"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node src/cli.ts --db .jobber-dev.db",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node src/build.ts dist/build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "spec": "node src/spec.ts && redocly build-docs openapi.json -o docs/index.html",
    "prepare": "npm run build && (git config core.hooksPath .githooks 2>/dev/null || true)",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@hono/node-server": "^2.1.5",
    "@hono/zod-openapi": "^1.6.3",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "hono": "^4.6.0",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@redocly/cli": "^2.71.1",
    "@types/node": "^24",
    "@types/ws": "^8.18.2",
    "typescript": "^5.7.2",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
