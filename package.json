{
  "name": "job-service",
  "version": "0.1.0",
  "private": true,
  "description": "Runs of jobs, claimed by runners, over HTTP, on SQLite.",
  "type": "module",
  "bin": {
    "job-service": "dist/cli.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node src/cli.ts --db .job-service-dev.db",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node src/build.ts dist/build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "spec": "node src/spec.ts && redocly build-docs openapi.json -o docs/index.html",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@hono/node-server": "^2.1.5",
    "@hono/zod-openapi": "^1.6.3",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "hono": "^4.6.0",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@redocly/cli": "^2.71.1",
    "@types/node": "^24",
    "@types/ws": "^8.18.2",
    "typescript": "^5.7.2",
    "vitest": "^5.0.5"
  }
}
